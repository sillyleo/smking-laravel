{
    "name": "smking/laravel",
    "description": "Laravel package for smking AEO — auto-inject JSON-LD, FAQ, and AI summary into Laravel responses so AI crawlers (ChatGPT, Perplexity, Google AI) can cite your pages.",
    "keywords": ["laravel", "seo", "aeo", "ai", "json-ld", "schema", "chatgpt", "perplexity", "smking"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://smking.io",
    "support": {
        "issues": "https://github.com/sillyleo/smking/issues",
        "source": "https://github.com/sillyleo/smking"
    },
    "authors": [
        {
            "name": "smking",
            "homepage": "https://smking.io"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Smking\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Smking\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Smking\\Laravel\\SmkingServiceProvider"
            ],
            "aliases": {
                "Smking": "Smking\\Laravel\\Facades\\Smking"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
